<?xml version="1.0" encoding="UTF-8"?>
<!-- Die Basisschicht hängt sich in jedes Addon: Messung, Protokoll, Schutzgeländer. -->
<web-fragment xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-fragment_4_0.xsd"
              version="4.0">
    <name>kieselstein_basiskit</name>
    <listener>
        <listener-class>at.freudenthaler.kieselstein.addon.basis.Basiskit</listener-class>
    </listener>
    <filter>
        <filter-name>basiskit-messung</filter-name>
        <filter-class>at.freudenthaler.kieselstein.addon.basis.Messfilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>basiskit-messung</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
</web-fragment>
